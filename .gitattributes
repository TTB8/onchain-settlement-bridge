# Normalize line endings so contributors on Windows and Linux get identical files.
* text=auto eol=lf
*.sh text eol=lf
pnpm-lock.yaml -diff

# harness-kit:begin
# Hook scripts must keep LF line endings on Windows checkouts (core.autocrlf
# would turn `#!/bin/sh` into `#!/bin/sh\r` and break every hook).
scripts/harness/** text eol=lf
.githooks/* text eol=lf
# harness-kit:end
