# Environment for `pnpm dev` (apps/api + apps/worker). Copy to `.env` (never committed) and edit.
# Every variable is validated at startup; an invalid file is refused with ONE error listing every
# problem by name (values are never printed). Parsing and rules: packages/engine/src/env.ts.
#
# Everything below is for a LOCAL Anvil chain and the docker-compose Postgres. DEV ONLY.

# --- Shared (api + worker) ----------------------------------------------------------------------

# Postgres. DEV ONLY credentials of docker-compose.yml. In production connect as a role that does
# NOT own the tables (the owner can disable the ledger's guard triggers); see apps/api/README.md.
DATABASE_URL=postgresql://bridge:bridge@localhost:5434/bridge

# JSON-RPC endpoint (http or https). A hosted URL usually carries an API key: it is treated as a
# secret and redacted from every log line and stored error text.
RPC_URL=http://127.0.0.1:8545

# The chain. 31337 / 1337 (local) run as configured. A public testnet needs ALLOW_TESTNET=true,
# a mainnet (1, 10, 56, 137, 8453, 42161, ...) ALLOW_MAINNET=true, any other id
# ALLOW_UNKNOWN_CHAIN=true. Only the literal values true / false are accepted. The node's own
# chain id must equal CHAIN_ID or both processes refuse to start.
CHAIN_ID=31337
ALLOW_TESTNET=false
ALLOW_MAINNET=false
ALLOW_UNKNOWN_CHAIN=false

# The deployment (0x + 40 hex, any case). Replace with the addresses in
# contracts/deployments/31337.json after deploying to Anvil. The database's ACTIVE deployment row
# for CHAIN_ID must be exactly this token + registry, or requests get 503 and the worker exits 1.
TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Confirmations before anything counts (default 12 when unset). 1 for a local Anvil only.
CONFIRMATION_DEPTH=1

# Per-request RPC timeout in ms (default 10000).
RPC_TIMEOUT_MS=10000

# error | warn | log | debug (default log). Lines are JSON, redacted.
LOG_LEVEL=log

# --- API (apps/api) -----------------------------------------------------------------------------

# Bind address (default 127.0.0.1: a forgotten variable never exposes the API) and port (3000).
API_HOST=127.0.0.1
API_PORT=3000

# Two static bearer tokens, 32-512 visible ASCII characters, and they must differ.
# PLATFORM: user, operation and balance routes. ADMIN: compliance and reconciliation routes.
# Neither works on the other's routes (403). DEV ONLY values below (a token containing
# "change-me" or "dev-only" is refused on any non-local chain); generate real ones with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_PLATFORM_TOKEN=dev-only-platform-token-change-me-0123456789
API_ADMIN_TOKEN=dev-only-admin-token-change-me-0123456789abc

# Largest amount one request may move, smallest unit (6 decimals). Default 1000000000000
# (one million tokens). At most 9223372036854775807 (the ledger column).
API_MAX_AMOUNT=1000000000000

# Request body limit in bytes (default 16384).
API_BODY_LIMIT_BYTES=16384

# Serve the OpenAPI UI at /docs and the JSON at /docs/openapi.json. Default: true on a local
# chain, false anywhere else (set true explicitly to publish the document there).
API_DOCS_ENABLED=true

# --- Worker (apps/worker) -----------------------------------------------------------------------

# Signer keys, 0x + 64 hex, and they must differ (each signer has its own nonce sequence).
# DEV ONLY: these are Anvil's well-known default accounts #1 and #2 (mnemonic "test test test
# test test test test test test test test junk"). They are PUBLIC; the worker refuses them on any
# non-local chain. Their addresses must be the deployment's signer rows (settlement = minter /
# settler role, 0x70997970C51812dc3A010C7d01b50e0d17dc79C8; compliance = registry role,
# 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC). Real keys belong in a secret manager or a KMS.
SETTLEMENT_SIGNER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
COMPLIANCE_SIGNER_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# The highest maxFeePerGas any transaction may pay, in wei. REQUIRED (no fee limit is a choice).
# 200 gwei here.
FEE_CAP_WEI=200000000000

# A label for outbox leases (letters, digits, . _ : -). Default <hostname>:<pid>.
# WORKER_ID=worker-1

# Delay between engine ticks in ms (default 2000).
POLL_INTERVAL_MS=2000

# Ticks between automatic reconciliation runs (default 10).
RECONCILE_EVERY_TICKS=10

# How long a shutdown waits for the tick in progress, ms (default 30000). Past it: exit 1.
SHUTDOWN_TIMEOUT_MS=30000
