{
  "name": "onchain-settlement-bridge",
  "private": true,
  "version": "0.1.0",
  "description": "Reference implementation of an off-chain ledger to on-chain settlement bridge: the database stays the source of truth, the contracts enforce compliance.",
  "license": "MIT",
  "author": "TTB8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TTB8/onchain-settlement-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/TTB8/onchain-settlement-bridge/issues"
  },
  "homepage": "https://github.com/TTB8/onchain-settlement-bridge#readme",
  "keywords": [
    "solidity",
    "foundry",
    "viem",
    "nestjs",
    "prisma",
    "web3",
    "ledger",
    "typescript"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup:local": "pnpm --silent --filter @bridge/e2e setup:local",
    "demo": "pnpm --silent --filter @bridge/e2e demo",
    "start:api": "pnpm --filter @bridge/api start",
    "start:worker": "pnpm --filter @bridge/worker start",
    "lint": "eslint . && pnpm lint:sol",
    "lint:sol": "cd contracts && forge fmt --check",
    "format": "prettier --write . && cd contracts && forge fmt",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:cov": "pnpm -r test:cov",
    "test:e2e": "pnpm --filter @bridge/e2e test",
    "test:e2e:hermetic": "node scripts/check-e2e-hermetic.mjs",
    "db:generate": "pnpm --filter @bridge/db db:generate",
    "db:seed": "pnpm --filter @bridge/db db:seed",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:snapshot": "cd contracts && forge snapshot --no-match-test \"testFuzz|invariant\"",
    "contracts:snapshot:check": "cd contracts && forge snapshot --check --no-match-test \"testFuzz|invariant\"",
    "contracts:coverage": "cd contracts && forge coverage --report summary --no-match-coverage \"(test|script)\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsdoc": "^65.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0"
  }
}
