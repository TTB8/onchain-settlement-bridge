{
  "name": "onchain-settlement-bridge",
  "private": true,
  "version": "0.1.0",
  "description": "Reference implementation of an off-chain ledger to on-chain settlement bridge: the database stays the source of truth, the contracts enforce compliance.",
  "license": "MIT",
  "author": "TTB8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TTB8/onchain-settlement-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/TTB8/onchain-settlement-bridge/issues"
  },
  "homepage": "https://github.com/TTB8/onchain-settlement-bridge#readme",
  "keywords": [
    "solidity",
    "foundry",
    "viem",
    "nestjs",
    "prisma",
    "web3",
    "ledger",
    "typescript"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . && pnpm lint:sol",
    "lint:sol": "cd contracts && forge fmt --check",
    "format": "prettier --write . && cd contracts && forge fmt",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:cov": "pnpm -r test:cov",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsdoc": "^65.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
