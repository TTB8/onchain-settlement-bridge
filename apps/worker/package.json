{
  "name": "@bridge/worker",
  "version": "0.1.0",
  "private": true,
  "description": "The bridge worker (NestJS standalone application context, no HTTP server): builds the viem gateway and the BridgeEngine from validated environment variables and runs the engine loop until SIGTERM / SIGINT.",
  "scripts": {
    "start": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@bridge/chain": "workspace:*",
    "@bridge/db": "workspace:*",
    "@bridge/engine": "workspace:*",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.11",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "viem": "2.58.3"
  }
}
