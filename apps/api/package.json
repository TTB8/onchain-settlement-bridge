{
  "name": "@bridge/api",
  "version": "0.1.0",
  "private": true,
  "description": "The bridge's HTTP API (NestJS): users, deposits, withdrawals, transfers, balances, compliance requests and reconciliation runs, on top of @bridge/engine. Holds no signing key.",
  "scripts": {
    "start": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@bridge/chain": "workspace:*",
    "@bridge/db": "workspace:*",
    "@bridge/engine": "workspace:*",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "viem": "2.58.4"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.11",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "^30.5.2",
    "supertest": "7.3.2",
    "ts-jest": "^29.4.15"
  }
}
