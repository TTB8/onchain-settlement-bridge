# DEVELOPMENT ONLY. These are the throwaway credentials of the local Postgres in docker-compose.yml.
# Copy to .env for local use; never put a real database password in this file.
DATABASE_URL="postgresql://bridge:bridge@localhost:5434/bridge?schema=public"

# Tests connect here (as the dev user) only to CREATE and DROP their own bridge_db_test_<random>
# databases. They never touch the bridge or bridge_test databases.
DB_TEST_ADMIN_URL="postgresql://bridge:bridge@localhost:5434/postgres"
