{
  "name": "@bridge/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "The local developer tooling (setup:local, demo; sources in ../scripts) and the end-to-end suite: real Postgres, a real anvil per file, the real contracts, API and engine in-process.",
  "scripts": {
    "setup:local": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ../scripts/setup-local.ts",
    "demo": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ../scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand"
  },
  "dependencies": {
    "@bridge/chain": "workspace:*",
    "@bridge/db": "workspace:*",
    "@bridge/engine": "workspace:*",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "viem": "2.58.4"
  }
}
